# Application
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173
API_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173

# MongoDB (required to connect)
MONGODB_URI=

# Authentication
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Refresh-token cookie
REFRESH_COOKIE_NAME=refreshToken
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Redis / BullMQ (required for durable meeting reminders and automatic room end)
REDIS_URL=

# Email OTP (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# File storage: cloudinary or s3
FILE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_IMAGE_UPLOAD_MB=5
MAX_VIDEO_UPLOAD_MB=50

# Firebase Cloud Messaging
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Browser registration values are public and belong in frontend/.env, not here.

# LiveKit scheduled group meetings (required for video rooms)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Phase 3 peer-to-peer calls
CALL_STUN_URL=stun:stun.l.google.com:19302

# Metered TURN Configuration
CALL_TURN_URLS=

# Use the Coturn shared secret for temporary credentials, or the static pair below.
CALL_TURN_SHARED_SECRET=
CALL_TURN_USERNAME=
CALL_TURN_CREDENTIAL=

# Comma-separated user IDs allowed to review reports
REPORT_ADMIN_USER_IDS=

# AI features (keep provider keys on the backend only)
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=50

# Logging / error monitoring
LOG_LEVEL=info
